{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cadenza",
  "version": "1.0.0",
  "identifier": "io.github.chedd4rr.cadenza",
  "build": {
    "frontendDist": "../Resources/web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "A Spotify client with its own sound engine",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libasound2"
        ]
      }
    },
    "externalBin": [
      "binaries/librespot"
    ],
    "resources": {
      "binaries/librespot-LICENSE.txt": "licenses/librespot-LICENSE.txt"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "cadenza"
        ]
      }
    }
  }
}
